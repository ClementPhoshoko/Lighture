<?xml version="1.0" encoding="utf-8"?>
<!-- Feature card: 135deg brand gradient (red-400 -> red-500 -> red-600). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/red_400"
        android:centerColor="@color/red_500"
        android:endColor="@color/red_600" />
    <corners android:radius="@dimen/radius_card_feature" />
</shape>
