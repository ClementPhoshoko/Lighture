<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/background_app" />
        </shape>
    </item>

    <!-- top-left cluster -->
    <item
        android:width="32dp"
        android:height="32dp"
        android:left="28dp"
        android:top="96dp"
        android:gravity="top|left"
        android:drawable="@drawable/ic_bg_carrot" />
    <item
        android:width="30dp"
        android:height="30dp"
        android:left="88dp"
        android:top="200dp"
        android:gravity="top|left"
        android:drawable="@drawable/ic_bg_bread" />

    <!-- top-right cluster -->
    <item
        android:width="28dp"
        android:height="28dp"
        android:right="32dp"
        android:top="72dp"
        android:gravity="top|right"
        android:drawable="@drawable/ic_bg_lemon" />
    <item
        android:width="26dp"
        android:height="26dp"
        android:right="64dp"
        android:top="228dp"
        android:gravity="top|right"
        android:drawable="@drawable/ic_bg_pepper" />

    <!-- mid sides -->
    <item
        android:width="36dp"
        android:height="36dp"
        android:left="20dp"
        android:gravity="center_vertical|left"
        android:drawable="@drawable/ic_bg_salad" />
    <item
        android:width="34dp"
        android:height="34dp"
        android:right="24dp"
        android:gravity="center_vertical|right"
        android:drawable="@drawable/ic_bg_apple" />

    <!-- bottom cluster -->
    <item
        android:width="34dp"
        android:height="34dp"
        android:left="56dp"
        android:bottom="112dp"
        android:gravity="bottom|left"
        android:drawable="@drawable/ic_bg_milk" />
    <item
        android:width="32dp"
        android:height="32dp"
        android:right="28dp"
        android:bottom="72dp"
        android:gravity="bottom|right"
        android:drawable="@drawable/ic_bg_egg" />
    <item
        android:width="30dp"
        android:height="30dp"
        android:right="132dp"
        android:bottom="184dp"
        android:gravity="bottom|right"
        android:drawable="@drawable/ic_bg_fish" />
</layer-list>
