<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Shadow / Glow Layer -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>

    <!-- Main Glass Surface -->
    <item
        android:bottom="4dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_background_red" />
            <corners android:radius="@dimen/radius_card" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_border" />
        </shape>
    </item>

    <!-- Inner Refractive Edge (Subtle white highlight) -->
    <item
        android:bottom="5dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</layer-list>
