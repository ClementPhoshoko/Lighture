<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass surface. True blur needs a translucent layer behind; pairing this
  background with a low elevation tint approximates the glass look.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_background" />
    <corners android:radius="@dimen/radius_card" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border" />
</shape>
