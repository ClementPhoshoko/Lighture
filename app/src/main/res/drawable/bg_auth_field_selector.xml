<?xml version="1.0" encoding="utf-8"?>
<!-- Auth field focus selector. Applied to the field card; focus is tracked
     in AuthActivity because the card itself is not focusable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_auth_field_focused" android:state_focused="true" />
    <item android:drawable="@drawable/bg_auth_field" />
</selector>
