<?xml version="1.0" encoding="utf-8"?>
<!--
  Fades the top edge of the bottom-anchored splash image into the pure white
  background, so the photo appears to emerge from the bottom.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/neutral_0"
        android:endColor="@android:color/transparent" />
</shape>
