<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass auth field. Large radius, slim neutral border, strong glass fill.
  Focus swap comes from bg_auth_field_selector.xml; shadow via elevation.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_background_strong" />
    <corners android:radius="@dimen/radius_2xl" />
    <stroke
        android:width="1dp"
        android:color="@color/input_border" />
</shape>
