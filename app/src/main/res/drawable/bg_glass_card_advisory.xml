<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Ultra-soft ambient shadow (Thinner 4dp bottom-right offset, extremely subtle 2% opacity) -->
    <item
        android:left="4dp"
        android:right="0dp"
        android:top="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#05000000" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>

    <!-- 2. Tight, light directional shadow (Subtle 3.5% opacity) -->
    <item
        android:left="3dp"
        android:right="1dp"
        android:top="3dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#09000000" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>

    <!-- 3. Main Glass Card Surface (Thinner 4dp offset with glassy border highlight) -->
    <item
        android:left="0dp"
        android:right="4dp"
        android:top="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_surface_white" />
            <corners android:radius="@dimen/radius_card" />
            <stroke
                android:width="1.2dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
</layer-list>
