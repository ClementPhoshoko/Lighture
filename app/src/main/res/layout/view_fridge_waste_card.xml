<?xml version="1.0" encoding="utf-8"?>
<!-- Reduce food waste card: advisory-style surface (soft brand-red tint, faint
     bin icon in the top-right) with a "View Recipes" primary action. Mirrors
     the Recipes AI advisory card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_privacy_card">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/space_4"
        android:alpha="0.18"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_outline_trash"
        app:tint="@color/brand_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding_compact">

        <TextView
            android:id="@+id/fridgeWasteTitle"
            style="@style/TextAppearance.Lighture.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fridge_waste_title"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/fridgeWasteBody"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:textColor="@color/text_secondary"
            tools:text="You have 2 items expiring soon. Use them in recipes to save money!" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fridgeWasteAction"
            style="@style/Widget.Lighture.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/fridge_waste_action"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/button_primary_text" />
    </LinearLayout>

</FrameLayout>
