<?xml version="1.0" encoding="utf-8"?>
<!-- Reduce food waste card: redesigned with premium glassmorphic style.
     Uses bg_glass_card_modern and standardized button styles. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card_modern"
    android:clipToOutline="true"
    android:elevation="@dimen/elevation_card">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/space_4"
        android:alpha="0.12"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_outline_trash"
        app:tint="@color/brand_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/fridgeWasteTitle"
            style="@style/TextAppearance.Lighture.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fridge_waste_title"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/fridgeWasteBody"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:textColor="@color/text_secondary"
            tools:text="You have 2 items expiring soon. Use them in recipes to save money!" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fridgeWasteAction"
            style="@style/Widget.Lighture.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/fridge_waste_action"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/space_1"
            app:iconSize="@dimen/size_icon_sm" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
