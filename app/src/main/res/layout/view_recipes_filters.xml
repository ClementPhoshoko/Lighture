<?xml version="1.0" encoding="utf-8"?>
<!-- Recipes toolbar row: compact filter button on the left, sort selector on
     the right. Both are stubs until the real filter/sort pipelines land. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recipesFilterButton"
        style="@style/Widget.Lighture.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/size_button_sm"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:text="@string/recipes_filter"
        app:icon="@drawable/ic_filter"
        app:iconPadding="@dimen/space_1_5"
        app:iconSize="@dimen/size_icon_sm" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/recipesSortButton"
        style="@style/TextAppearance.Lighture.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/ic_chevron_down"
        android:drawablePadding="@dimen/space_1"
        android:drawableTint="@color/icon_secondary"
        android:gravity="center_vertical"
        android:text="@string/recipes_sort_by"
        android:textColor="@color/text_secondary" />

</LinearLayout>
