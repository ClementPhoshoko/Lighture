<?xml version="1.0" encoding="utf-8"?>
<!-- Recipes toolbar row: sort selector and search.
     Used inside sticky header which provides glass background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recipesFiltersRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Row 1: Sort Button and Search Toggle -->
    <LinearLayout
        android:id="@+id/recipesSortContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/recipesSortButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_2"
            android:paddingTop="@dimen/space_1"
            android:paddingBottom="@dimen/space_1">

            <TextView
                style="@style/TextAppearance.Lighture.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recipes_sort_by_prefix"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/recipesSortValueLabel"
                style="@style/TextAppearance.Lighture.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/recipes_sort_recommended"
                android:textColor="@color/brand_primary" />

            <ImageView
                android:layout_width="@dimen/size_icon_sm"
                android:layout_height="@dimen/size_icon_sm"
                android:layout_marginStart="@dimen/space_0_5"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/brand_primary" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/recipesSearchButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_icon_container"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/space_3">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/recipes_search_description"
                android:src="@drawable/ic_search"
                app:tint="@color/icon_primary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Active Search Bar (Overlays Sort Container) -->
    <LinearLayout
        android:id="@+id/recipesSearchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_1"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/text_tertiary" />

        <EditText
            android:id="@+id/recipesSearchInput"
            style="@style/TextAppearance.Lighture.Body"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/recipes_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="@dimen/font_size_sm" />

        <ImageButton
            android:id="@+id/recipesSearchClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recipes_search_close"
            android:padding="@dimen/space_2_5"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/icon_secondary" />
    </LinearLayout>
</LinearLayout>
