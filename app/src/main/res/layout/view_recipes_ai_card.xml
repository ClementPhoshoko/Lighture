<?xml version="1.0" encoding="utf-8"?>
<!-- AI Recipe Magic advisory card: clean white surface with no borders.
     Matches the home advisory style. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Lighture.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_5">

        <ImageView
            android:id="@+id/recipesAiIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:alpha="0.12"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_ai"
            app:tint="@color/brand_primary" />

        <TextView
            android:id="@+id/recipesAiTitle"
            style="@style/TextAppearance.Lighture.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/recipes_ai_title"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/recipesAiBody"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:text="@string/recipes_ai_body"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toStartOf="@+id/recipesAiIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recipesAiTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recipesAiGenerateButton"
            style="@style/Widget.Lighture.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/recipes_ai_generate"
            app:icon="@drawable/ic_ai"
            app:iconTint="@color/button_primary_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recipesAiBody"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
