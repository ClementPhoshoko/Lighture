<?xml version="1.0" encoding="utf-8"?>
<!-- Fridge page header: title + subtitle column with a compact "Scan Fridge"
     action button on the right, mirroring the Recipes page header layout. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_2">

    <TextView
        android:id="@+id/fridgeTitle"
        style="@style/TextAppearance.Lighture.PageTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fridge_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_size_xl"
        app:layout_constraintEnd_toStartOf="@+id/fridgeScanButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/fridgeSubtitle"
        style="@style/TextAppearance.Lighture.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_0_5"
        android:text="@string/fridge_subtitle"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toStartOf="@+id/fridgeScanButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fridgeTitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fridgeScanButton"
        style="@style/Widget.Lighture.Button.Soft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/size_button_md"
        android:layout_marginStart="@dimen/space_3"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:text="@string/fridge_scan"
        android:textAllCaps="false"
        app:icon="@drawable/ic_camera"
        app:iconPadding="@dimen/space_1_5"
        app:iconSize="@dimen/size_icon_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Lighture.Button.Small" />

</androidx.constraintlayout.widget.ConstraintLayout>
