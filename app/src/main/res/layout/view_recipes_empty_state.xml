<?xml version="1.0" encoding="utf-8"?>
<!-- Recipes empty state: shown below the AI Recipe Magic card when no recipes
     have been generated yet. Avatar-style placeholder photo on the left with
     the advisory title and body on the right. Borderless by design. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_6"
    android:paddingBottom="@dimen/space_6">

    <ImageView
        android:id="@+id/recipesEmptyImage"
        android:layout_width="@dimen/recipes_empty_avatar_size"
        android:layout_height="@dimen/recipes_empty_avatar_size"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@android:color/transparent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_5"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recipesEmptyTitle"
            style="@style/TextAppearance.Lighture.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recipes_empty_title"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/recipesEmptyBody"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:text="@string/recipes_empty_body"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
