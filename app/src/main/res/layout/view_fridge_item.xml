<?xml version="1.0" encoding="utf-8"?>
<!-- Fridge ingredient row: redesigned as a premium glassmorphic card,
     matching the Recipe list item aesthetic. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fridgeItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:background="@drawable/bg_glass_card_modern"
    android:clipToOutline="true"
    android:clickable="true"
    android:elevation="@dimen/elevation_card"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="72dp">

    <FrameLayout
        android:id="@+id/fridgeItemArt"
        android:layout_width="@dimen/size_avatar_lg"
        android:layout_height="@dimen/size_avatar_lg"
        android:layout_marginStart="@dimen/space_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/fridgeItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/fridgeItemEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="32sp"
            android:visibility="gone"
            tools:text="🥑"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fridgeItemStatusContainer"
        app:layout_constraintStart_toEndOf="@id/fridgeItemArt"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/fridgeItemName"
            style="@style/TextAppearance.Lighture.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            tools:text="Tomatoes" />

        <TextView
            android:id="@+id/fridgeItemQuantity"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            tools:text="5 pieces" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fridgeItemStatusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_3"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fridgeItemActionContainer"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/fridgeItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_pill"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_0_5"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_0_5"
            android:textSize="11sp"
            tools:backgroundTint="@color/fresh_background"
            tools:text="Fresh"
            tools:textColor="@color/fresh_color" />

        <TextView
            android:id="@+id/fridgeItemExpiry"
            style="@style/TextAppearance.Lighture.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:drawablePadding="@dimen/space_1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            app:drawableStartCompat="@drawable/ic_calendar"
            app:drawableTint="@color/icon_secondary"
            tools:text="3 days left" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fridgeItemActionContainer"
        android:layout_width="@dimen/size_icon_lg"
        android:layout_height="@dimen/size_icon_lg"
        android:layout_marginEnd="@dimen/space_3"
        android:background="@drawable/bg_icon_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/size_icon_xs"
            android:layout_height="@dimen/size_icon_xs"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/icon_primary" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
