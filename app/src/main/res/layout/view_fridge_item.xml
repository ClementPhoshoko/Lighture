<?xml version="1.0" encoding="utf-8"?>
<!-- Fridge ingredient row: designed as a list item for a grouped container.
     Contains food-art thumb, name/quantity, status/expiry block and a chevron.
     Dividers are handled by the adapter to prevent a trailing line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fridgeItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_5"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_5"
        android:paddingBottom="@dimen/space_4">

        <FrameLayout
            android:layout_width="@dimen/size_avatar_lg"
            android:layout_height="@dimen/size_avatar_lg">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/fridgeItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="@dimen/space_2"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fridgeItemName"
                style="@style/TextAppearance.Lighture.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                tools:text="Tomatoes" />

            <TextView
                android:id="@+id/fridgeItemQuantity"
                style="@style/TextAppearance.Lighture.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0_5"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                tools:text="5 pieces" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:baselineAligned="false"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fridgeItemStatus"
                style="@style/TextAppearance.Lighture.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_pill"
                android:maxLines="1"
                android:paddingStart="@dimen/space_2"
                android:paddingTop="@dimen/space_0_5"
                android:paddingEnd="@dimen/space_2"
                android:paddingBottom="@dimen/space_0_5"
                tools:backgroundTint="@color/fresh_background"
                tools:text="Fresh"
                tools:textColor="@color/fresh_color" />

            <TextView
                android:id="@+id/fridgeItemExpiry"
                style="@style/TextAppearance.Lighture.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:drawablePadding="@dimen/space_1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/icon_secondary"
                tools:text="3 days left" />
        </LinearLayout>

        <TextView
            android:id="@+id/fridgeItemArrow"
            android:layout_width="@dimen/size_icon_sm"
            android:layout_height="@dimen/size_icon_sm"
            android:layout_marginStart="@dimen/space_3"
            android:gravity="center"
            app:drawableStartCompat="@drawable/ic_chevron_right"
            app:drawableTint="@color/icon_tertiary"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <View
        android:id="@+id/itemDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_16"
        android:background="@color/divider" />

</LinearLayout>
