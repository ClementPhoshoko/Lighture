<?xml version="1.0" encoding="utf-8"?>
<!-- Fridge ingredient row: rounded food-art thumb on the left, name + quantity
     in the middle, a freshness status pill with a calendar expiry line on the
     right and a chevron action at the end. Binds via FridgeItemsAdapter. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fridgeItem"
    style="@style/Widget.Lighture.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_0_5"
    android:layout_marginEnd="@dimen/space_0_5"
    android:layout_marginBottom="@dimen/space_3"
    android:foreground="?attr/selectableItemBackground">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding_compact">

        <FrameLayout
            android:layout_width="@dimen/size_avatar_lg"
            android:layout_height="@dimen/size_avatar_lg">

            <ImageView
                android:id="@+id/fridgeItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="@dimen/space_2"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fridgeItemName"
                style="@style/TextAppearance.Lighture.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/fridgeItemQuantity"
                style="@style/TextAppearance.Lighture.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0_5"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_4"
            android:baselineAligned="false"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fridgeItemStatus"
                style="@style/TextAppearance.Lighture.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_pill"
                android:maxLines="1"
                android:paddingStart="@dimen/space_2"
                android:paddingTop="@dimen/space_0_5"
                android:paddingEnd="@dimen/space_2"
                android:paddingBottom="@dimen/space_0_5" />

            <TextView
                android:id="@+id/fridgeItemExpiry"
                style="@style/TextAppearance.Lighture.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:drawableStartCompat="@drawable/ic_calendar"
                android:drawablePadding="@dimen/space_1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                app:drawableTint="@color/icon_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/fridgeItemArrow"
            android:layout_width="@dimen/size_icon_lg"
            android:layout_height="@dimen/size_icon_lg"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_icon_circle"
            android:gravity="center"
            app:drawableStartCompat="@drawable/ic_chevron_right"
            app:drawableTint="@color/icon_primary"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
