<?xml version="1.0" encoding="utf-8"?>
<!-- Smart suggestion card: art with a time pill overlay, then the recipe title
     and the matching ingredient count. clipToOutline keeps children inside the
     rounded card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/suggestionCard"
    android:layout_width="@dimen/recipe_card_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToOutline="true"
    android:elevation="@dimen/elevation_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/suggestionArt"
        android:layout_width="match_parent"
        android:layout_height="@dimen/recipe_art_height"
        android:background="@drawable/bg_recipe_image">

        <ImageView
            android:id="@+id/suggestionIcon"
            android:layout_width="@dimen/size_icon_xl"
            android:layout_height="@dimen/size_icon_xl"
            android:layout_gravity="center"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/suggestionTimePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/space_2"
            android:background="@drawable/bg_time_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_0_5"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_0_5">

            <ImageView
                android:layout_width="@dimen/size_icon_xs"
                android:layout_height="@dimen/size_icon_xs"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock"
                app:tint="@color/icon_tertiary" />

            <TextView
                android:id="@+id/suggestionTime"
                style="@style/TextAppearance.Lighture.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding_compact">

        <TextView
            android:id="@+id/suggestionTitle"
            style="@style/TextAppearance.Lighture.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/suggestionUses"
            style="@style/TextAppearance.Lighture.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
