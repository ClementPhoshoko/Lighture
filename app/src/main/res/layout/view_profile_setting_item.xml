<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/space_4">

    <FrameLayout
        android:id="@+id/settingIconContainer"
        android:layout_width="@dimen/size_touch_min"
        android:layout_height="@dimen/size_touch_min"
        android:background="@drawable/bg_icon_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/settingIcon"
            android:layout_width="@dimen/size_icon_md"
            android:layout_height="@dimen/size_icon_md"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/brand_primary"
            tools:src="@drawable/ic_grid" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/settingTextContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_2"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/chevronIcon"
        app:layout_constraintStart_toEndOf="@id/settingIconContainer"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/settingTitle"
            style="@style/TextAppearance.Lighture.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            tools:text="Setting Title" />

        <TextView
            android:id="@+id/settingValue"
            style="@style/TextAppearance.Lighture.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="Setting Value"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageView
        android:id="@+id/chevronIcon"
        android:layout_width="@dimen/size_icon_xs"
        android:layout_height="@dimen/size_icon_xs"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/icon_secondary" />

</androidx.constraintlayout.widget.ConstraintLayout>
