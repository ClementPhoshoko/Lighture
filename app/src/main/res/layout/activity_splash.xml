<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    tools:context=".SplashActivity">

    <!-- Soft red glow behind the logo -->
    <View
        android:id="@+id/splashGlow"
        android:layout_width="@dimen/splash_glow_size"
        android:layout_height="@dimen/splash_glow_size"
        android:alpha="0.55"
        android:background="@drawable/splash_glow"
        app:layout_constraintBottom_toBottomOf="@id/splashLogo"
        app:layout_constraintEnd_toEndOf="@id/splashLogo"
        app:layout_constraintStart_toStartOf="@id/splashLogo"
        app:layout_constraintTop_toTopOf="@id/splashLogo" />

    <!-- Decorative food illustrations, softly faded and cropped at the edges -->
    <ImageView
        android:id="@+id/foodTopLeft"
        android:layout_width="@dimen/splash_food_size"
        android:layout_height="@dimen/splash_food_size"
        android:alpha="0.20"
        android:contentDescription="@string/splash_food_description"
        android:rotation="-18"
        app:srcCompat="@drawable/ic_food_apple"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="-16dp"
        android:layout_marginTop="-16dp" />

    <ImageView
        android:id="@+id/foodTopRight"
        android:layout_width="@dimen/splash_food_size_lg"
        android:layout_height="@dimen/splash_food_size_lg"
        android:alpha="0.16"
        android:contentDescription="@string/splash_food_description"
        android:rotation="14"
        app:srcCompat="@drawable/ic_food_bread"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="-24dp"
        android:layout_marginTop="-24dp" />

    <ImageView
        android:id="@+id/foodBottomLeft"
        android:layout_width="@dimen/splash_food_size"
        android:layout_height="@dimen/splash_food_size"
        android:alpha="0.18"
        android:contentDescription="@string/splash_food_description"
        android:rotation="12"
        app:srcCompat="@drawable/ic_food_cheese"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-20dp"
        android:layout_marginStart="-20dp" />

    <ImageView
        android:id="@+id/foodBottomRight"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0.16"
        android:contentDescription="@string/splash_food_description"
        android:rotation="-10"
        app:srcCompat="@drawable/ic_food_bottle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-24dp"
        android:layout_marginEnd="-24dp" />

    <!-- Brand logo -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="@dimen/splash_logo_width"
        android:layout_height="@dimen/splash_logo_height"
        android:alpha="0"
        android:contentDescription="@string/splash_content_description"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/splash_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42" />

    <!-- Sparkles around the logo -->
    <ImageView
        android:id="@+id/sparkleTopLeft"
        android:layout_width="@dimen/splash_sparkle_sm"
        android:layout_height="@dimen/splash_sparkle_sm"
        android:alpha="0"
        android:contentDescription="@string/splash_sparkle_description"
        app:srcCompat="@drawable/ic_sparkle"
        app:layout_constraintEnd_toStartOf="@id/splashLogo"
        app:layout_constraintTop_toTopOf="@id/splashLogo"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="14dp" />

    <ImageView
        android:id="@+id/sparkleTopRight"
        android:layout_width="@dimen/splash_sparkle_md"
        android:layout_height="@dimen/splash_sparkle_md"
        android:alpha="0"
        android:contentDescription="@string/splash_sparkle_description"
        app:srcCompat="@drawable/ic_sparkle"
        app:layout_constraintStart_toEndOf="@id/splashLogo"
        app:layout_constraintTop_toTopOf="@id/splashLogo"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp" />

    <ImageView
        android:id="@+id/sparkleBottomRight"
        android:layout_width="@dimen/splash_sparkle_sm"
        android:layout_height="@dimen/splash_sparkle_sm"
        android:alpha="0"
        android:contentDescription="@string/splash_sparkle_description"
        app:srcCompat="@drawable/ic_sparkle"
        app:layout_constraintStart_toEndOf="@id/splashLogo"
        app:layout_constraintBottom_toBottomOf="@id/splashLogo"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="18dp" />

    <!-- Brand name, tagline and loading indicator -->
    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splashLogo"
        android:layout_marginTop="@dimen/space_6">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/splashBrandStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_brand_start"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="@dimen/splash_brand_size" />

            <TextView
                android:id="@+id/splashBrandAccent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_brand_accent"
                android:textColor="@color/red_accent"
                android:textStyle="bold"
                android:textSize="@dimen/splash_brand_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:fontFamily="@font/inter_regular"
            android:text="@string/splash_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/font_size_md" />

        <LinearLayout
            android:id="@+id/splashLoadingRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:contentDescription="@string/splash_loading_description"
            android:orientation="horizontal">

            <View
                android:id="@+id/splashDot1"
                android:layout_width="@dimen/splash_dot_size"
                android:layout_height="@dimen/splash_dot_size"
                android:alpha="0.25"
                android:background="@drawable/splash_dot" />

            <View
                android:id="@+id/splashDot2"
                android:layout_width="@dimen/splash_dot_size"
                android:layout_height="@dimen/splash_dot_size"
                android:layout_marginStart="@dimen/space_1_5"
                android:layout_marginEnd="@dimen/space_1_5"
                android:alpha="0.25"
                android:background="@drawable/splash_dot" />

            <View
                android:id="@+id/splashDot3"
                android:layout_width="@dimen/splash_dot_size"
                android:layout_height="@dimen/splash_dot_size"
                android:alpha="0.25"
                android:background="@drawable/splash_dot" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2_5"
            android:fontFamily="@font/inter_regular"
            android:text="@string/splash_loading"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/font_size_sm" />
    </LinearLayout>

    <!-- Version footer -->
    <TextView
        android:id="@+id/splashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="@string/splash_version"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/font_size_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="@dimen/space_4" />

</androidx.constraintlayout.widget.ConstraintLayout>
