<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    tools:context=".SplashActivity">

    <!-- Upper zone: small icon, system name and caption -->

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="238dp"
        android:layout_height="234dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/splashImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.746"
        android:layout_marginBottom="@dimen/space_6">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="@dimen/splash_logo_width"
            android:layout_height="@dimen/splash_logo_height"
            android:contentDescription="@string/splash_content_description"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/splash_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/splashBrandStart"
                style="@style/TextAppearance.Lighture.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_brand_start"
                android:textColor="@color/neutral_900" />

            <TextView
                android:id="@+id/splashBrandAccent"
                style="@style/TextAppearance.Lighture.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_brand_accent"
                android:textColor="@color/red_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashTagline"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/splash_tagline"
            android:textColor="@color/neutral_600" />
    </LinearLayout>

    <ImageView
        android:id="@+id/splashImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/splash_image_description"
        android:scaleType="fitCenter"
        android:src="@drawable/chef_teenagers"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Version footer -->
    <TextView
        android:id="@+id/splashVersion"
        style="@style/TextAppearance.Lighture.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:text="@string/splash_version"
        android:textColor="@color/neutral_500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
