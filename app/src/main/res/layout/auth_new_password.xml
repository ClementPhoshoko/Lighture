<?xml version="1.0" encoding="utf-8"?>
<!-- New-password content, inflated into the auth frame. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_x"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/page_padding_x"
        android:paddingBottom="@dimen/space_8">

        <include
            android:id="@+id/authHeader"
            layout="@layout/view_auth_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4" />

        <TextView
            android:id="@+id/newPasswordTitle"
            style="@style/TextAppearance.Lighture.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center_horizontal"
            android:text="@string/auth_new_password_title"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/newPasswordSubtitle"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_horizontal"
            android:text="@string/auth_new_password_subtitle"
            android:textColor="@color/text_secondary" />

        <!-- New password field -->
        <LinearLayout
            android:id="@+id/newPasswordField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/bg_auth_field_selector"
            android:elevation="@dimen/elevation_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <FrameLayout
                android:id="@+id/newPasswordIconContainer"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/newPasswordIcon"
                    android:layout_width="@dimen/size_icon_md"
                    android:layout_height="@dimen/size_icon_md"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_lock"
                    app:tint="@color/icon_brand" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/newPasswordFieldBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/newPasswordLabel"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_field_label_new_password"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/newPasswordInput"
                    style="@style/TextAppearance.Lighture.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/auth_hint_password"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="@dimen/size_touch_min"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_placeholder" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/toggleNewPassword"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_show_password"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_eye"
                app:tint="@color/icon_secondary" />
        </LinearLayout>

        <!-- Confirm password field -->
        <LinearLayout
            android:id="@+id/newConfirmField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_auth_field_selector"
            android:elevation="@dimen/elevation_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <FrameLayout
                android:id="@+id/newConfirmIconContainer"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/newConfirmIcon"
                    android:layout_width="@dimen/size_icon_md"
                    android:layout_height="@dimen/size_icon_md"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_lock"
                    app:tint="@color/icon_brand" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/newConfirmFieldBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/newConfirmLabel"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_field_label_confirm"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/newConfirmInput"
                    style="@style/TextAppearance.Lighture.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/auth_hint_password"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="@dimen/size_touch_min"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_placeholder" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/toggleNewConfirm"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_show_password"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_eye"
                app:tint="@color/icon_secondary" />
        </LinearLayout>

        <!-- Password strength card -->
        <FrameLayout
            android:id="@+id/strengthCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_privacy_card">

            <LinearLayout
                android:id="@+id/strengthContentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_compact">

                <FrameLayout
                    android:id="@+id/strengthIconContainer"
                    android:layout_width="@dimen/size_touch_min"
                    android:layout_height="@dimen/size_touch_min"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:id="@+id/strengthIcon"
                        android:layout_width="@dimen/size_icon_md"
                        android:layout_height="@dimen/size_icon_md"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_shield"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/strengthTextBlock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/strengthTitle"
                        style="@style/TextAppearance.Lighture.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_register_requirements_title"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/strengthBody"
                        style="@style/TextAppearance.Lighture.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/auth_register_requirements"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/savePasswordButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_lg"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/bg_button_gradient"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawablePadding="@dimen/space_2"
            android:drawableTint="@color/text_inverse"
            android:elevation="@dimen/elevation_card"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:text="@string/auth_new_password_button"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.Lighture.Label"
            android:textColor="@color/text_inverse" />

        <TextView
            android:id="@+id/backToLoginLink"
            style="@style/TextAppearance.Lighture.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_6"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/auth_new_password_back"
            android:textColor="@color/text_brand" />

    </LinearLayout>
</ScrollView>
