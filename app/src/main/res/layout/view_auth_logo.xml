<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable auth header: brand wordmark + tagline (no tall logo so the
     auth pages fit on screen without scrolling).
     Shared by login, register and forgot-password content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/authBrandRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/authBrandStart"
            style="@style/TextAppearance.Lighture.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_brand_start"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/authBrandAccent"
            style="@style/TextAppearance.Lighture.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_brand_accent"
            android:textColor="@color/text_brand" />
    </LinearLayout>

    <TextView
        android:id="@+id/authTagline"
        style="@style/TextAppearance.Lighture.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/auth_tagline"
        android:textColor="@color/text_secondary" />

</LinearLayout>
