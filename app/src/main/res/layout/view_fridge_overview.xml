<?xml version="1.0" encoding="utf-8"?>
<!-- Fridge overview card: redesigned with premium glassmorphic style,
     matching the Home Hero and Recipes list look. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card_modern"
    android:clipToOutline="true"
    android:elevation="@dimen/elevation_card">

    <!-- Ambient glow -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="-32dp"
        android:alpha="0.2"
        android:contentDescription="@null"
        android:src="@drawable/ic_decorative_blob"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/glass_blob_danger" />

    <!-- Left Column: Stats -->
    <LinearLayout
        android:id="@+id/fridgeStatsColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fridgeIllustrationContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/fridgeOverviewTitle"
            style="@style/TextAppearance.Lighture.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fridge_overview_title"
            android:textColor="@color/text_primary" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4">

            <!-- Items -->
            <LinearLayout
                android:id="@+id/fridgeStatItems"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/size_icon_sm"
                        android:layout_height="@dimen/size_icon_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_basket"
                        app:tint="@color/fresh_color" />

                    <TextView
                        android:id="@+id/fridgeStatItemsValue"
                        style="@style/TextAppearance.Lighture.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1"
                        android:textColor="@color/text_primary"
                        tools:text="12" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:text="@string/fridge_stat_items"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Fresh -->
            <LinearLayout
                android:id="@+id/fridgeStatFresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/size_icon_sm"
                        android:layout_height="@dimen/size_icon_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_leaf"
                        app:tint="@color/fresh_color" />

                    <TextView
                        android:id="@+id/fridgeStatFreshValue"
                        style="@style/TextAppearance.Lighture.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1"
                        android:textColor="@color/text_primary"
                        tools:text="5" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:text="@string/fridge_stat_fresh"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Expiring -->
            <LinearLayout
                android:id="@+id/fridgeStatExpiring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/size_icon_sm"
                        android:layout_height="@dimen/size_icon_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_clock"
                        app:tint="@color/expiring_color" />

                    <TextView
                        android:id="@+id/fridgeStatExpiringValue"
                        style="@style/TextAppearance.Lighture.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1"
                        android:textColor="@color/text_primary"
                        tools:text="2" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:text="@string/fridge_stat_expiring"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Saved -->
            <LinearLayout
                android:id="@+id/fridgeStatSaved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/size_icon_sm"
                        android:layout_height="@dimen/size_icon_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_trend_up"
                        app:tint="@color/fresh_color" />

                    <TextView
                        android:id="@+id/fridgeStatSavedValue"
                        style="@style/TextAppearance.Lighture.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1"
                        android:textColor="@color/text_primary"
                        tools:text="R156" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:text="@string/fridge_stat_saved"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/fridgeStatsFlow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="fridgeStatItems,fridgeStatFresh,fridgeStatExpiring,fridgeStatSaved"
                app:flow_horizontalGap="@dimen/space_3"
                app:flow_maxElementsWrap="2"
                app:flow_verticalGap="@dimen/space_3"
                app:flow_wrapMode="aligned"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Right Column: Illustration with Blur/Fade effect -->
    <FrameLayout
        android:id="@+id/fridgeIllustrationContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.3">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/fridgeOverviewIllustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Fade Overlay -->
        <View
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:alpha="0.5"
            android:background="@drawable/bg_fade_left" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
