<?xml version="1.0" encoding="utf-8"?>
<!-- Fridge overview card: redesigned with horizontal flex stats
     and a high-quality robot chef illustration with a soft fade blend. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left Column: Stats -->
        <LinearLayout
            android:id="@+id/fridgeStatsColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_3"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/fridgeIllustrationContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/fridgeOverviewTitle"
                style="@style/TextAppearance.Lighture.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fridge_overview_title"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:baselineAligned="false"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_0"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Items -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_0"
                        android:paddingEnd="@dimen/space_5">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/size_icon_md"
                                android:layout_height="@dimen/size_icon_md"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_outline_basket"
                                app:tint="@color/fresh_color" />

                            <TextView
                                android:id="@+id/fridgeStatItemsValue"
                                style="@style/TextAppearance.Lighture.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_1"
                                android:textColor="@color/text_primary"
                                tools:text="12" />
                        </LinearLayout>

                        <TextView
                            style="@style/TextAppearance.Lighture.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_0_5"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/fridge_stat_items"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Fresh -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/size_icon_md"
                                android:layout_height="@dimen/size_icon_md"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_outline_leaf"
                                app:tint="@color/fresh_color" />

                            <TextView
                                android:id="@+id/fridgeStatFreshValue"
                                style="@style/TextAppearance.Lighture.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_1"
                                android:textColor="@color/text_primary"
                                tools:text="5" />
                        </LinearLayout>

                        <TextView
                            style="@style/TextAppearance.Lighture.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_0_5"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/fridge_stat_fresh"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Expiring -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/size_icon_md"
                                android:layout_height="@dimen/size_icon_md"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_outline_clock"
                                app:tint="@color/expiring_color" />

                            <TextView
                                android:id="@+id/fridgeStatExpiringValue"
                                style="@style/TextAppearance.Lighture.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_1"
                                android:textColor="@color/text_primary"
                                tools:text="2" />
                        </LinearLayout>

                        <TextView
                            style="@style/TextAppearance.Lighture.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_0_5"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/fridge_stat_expiring"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Saved -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/size_icon_md"
                                android:layout_height="@dimen/size_icon_md"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_outline_trend_up"
                                app:tint="@color/fresh_color" />

                            <TextView
                                android:id="@+id/fridgeStatSavedValue"
                                style="@style/TextAppearance.Lighture.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_1"
                                android:textColor="@color/text_primary"
                                tools:text="R156" />
                        </LinearLayout>

                        <TextView
                            style="@style/TextAppearance.Lighture.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_0_5"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/fridge_stat_saved"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: Illustration with Blur/Fade effect -->
        <FrameLayout
            android:id="@+id/fridgeIllustrationContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.28">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/fridgeOverviewIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Lighture.Card"
                android:paddingEnd="@dimen/space_4"/>

            <!-- Blurriness/Fade Overlay on the left side of the image -->
            <View
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/bg_fade_left"
                />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
