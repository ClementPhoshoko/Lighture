<?xml version="1.0" encoding="utf-8"?>
<!-- Fridge overview card: two-column layout with a 2x2 stat grid on the left
     and a high-quality robot chef illustration on the right.
     Icons are simplified (no background) for a modern, airy feel.
     Now uses FrameLayout + bg_overview_stat_card to match the Home Overview's flat look. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overview_stat_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left Column: Stats -->
        <LinearLayout
            android:id="@+id/fridgeStatsColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/fridgeIllustrationContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/fridgeOverviewTitle"
                style="@style/TextAppearance.Lighture.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fridge_overview_title"
                android:textColor="@color/text_primary" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Items -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/space_2">

                    <ImageView
                        android:layout_width="@dimen/size_icon_md"
                        android:layout_height="@dimen/size_icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_basket"
                        app:tint="@color/fresh_color" />

                    <TextView
                        android:id="@+id/fridgeStatItemsValue"
                        style="@style/TextAppearance.Lighture.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textColor="@color/text_primary"
                        tools:text="12" />

                    <TextView
                        android:id="@+id/fridgeStatItemsLabel"
                        style="@style/TextAppearance.Lighture.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/fridge_stat_items"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Fresh -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="start"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/size_icon_md"
                        android:layout_height="@dimen/size_icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_leaf"
                        app:tint="@color/fresh_color" />

                    <TextView
                        android:id="@+id/fridgeStatFreshValue"
                        style="@style/TextAppearance.Lighture.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textColor="@color/text_primary"
                        tools:text="5" />

                    <TextView
                        android:id="@+id/fridgeStatFreshLabel"
                        style="@style/TextAppearance.Lighture.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/fridge_stat_fresh"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Expiring -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/space_2">

                    <ImageView
                        android:layout_width="@dimen/size_icon_md"
                        android:layout_height="@dimen/size_icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_clock"
                        app:tint="@color/expiring_color" />

                    <TextView
                        android:id="@+id/fridgeStatExpiringValue"
                        style="@style/TextAppearance.Lighture.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textColor="@color/text_primary"
                        tools:text="2" />

                    <TextView
                        android:id="@+id/fridgeStatExpiringLabel"
                        style="@style/TextAppearance.Lighture.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/fridge_stat_expiring"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Saved -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="start"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/size_icon_md"
                        android:layout_height="@dimen/size_icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_trend_up"
                        app:tint="@color/fresh_color" />

                    <TextView
                        android:id="@+id/fridgeStatSavedValue"
                        style="@style/TextAppearance.Lighture.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textColor="@color/text_primary"
                        tools:text="R156" />

                    <TextView
                        android:id="@+id/fridgeStatSavedLabel"
                        style="@style/TextAppearance.Lighture.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/fridge_stat_saved"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

        <!-- Right Column: Illustration -->
        <FrameLayout
            android:id="@+id/fridgeIllustrationContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4">

            <ImageView
                android:id="@+id/fridgeOverviewIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom|end"
                android:contentDescription="@null"
                android:scaleType="fitEnd" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
