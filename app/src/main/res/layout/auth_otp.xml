<?xml version="1.0" encoding="utf-8"?>
<!-- OTP verification content, inflated into the auth frame. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_x"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/page_padding_x"
        android:paddingBottom="@dimen/space_8">

        <include
            android:id="@+id/authHeader"
            layout="@layout/view_auth_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4" />

        <TextView
            android:id="@+id/otpTitle"
            style="@style/TextAppearance.Lighture.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center_horizontal"
            android:text="@string/auth_otp_title"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/otpSubtitle"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_horizontal"
            android:text="@string/auth_otp_subtitle"
            android:textColor="@color/text_secondary" />

        <!-- Six OTP digit boxes -->
        <LinearLayout
            android:id="@+id/otpRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:baselineAligned="false"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/otpDigit1"
                tools:ignore="LabelFor"
                style="@style/TextAppearance.Lighture.SectionTitle"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:background="@drawable/bg_otp_box"
                android:cursorVisible="true"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:maxLines="1"
                android:padding="0dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_placeholder" />

            <EditText
                android:id="@+id/otpDigit2"
                tools:ignore="LabelFor"
                style="@style/TextAppearance.Lighture.SectionTitle"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_otp_box"
                android:cursorVisible="true"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:maxLines="1"
                android:padding="0dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_placeholder" />

            <EditText
                android:id="@+id/otpDigit3"
                tools:ignore="LabelFor"
                style="@style/TextAppearance.Lighture.SectionTitle"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_otp_box"
                android:cursorVisible="true"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:maxLines="1"
                android:padding="0dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_placeholder" />

            <EditText
                android:id="@+id/otpDigit4"
                tools:ignore="LabelFor"
                style="@style/TextAppearance.Lighture.SectionTitle"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_otp_box"
                android:cursorVisible="true"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:maxLines="1"
                android:padding="0dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_placeholder" />

            <EditText
                android:id="@+id/otpDigit5"
                tools:ignore="LabelFor"
                style="@style/TextAppearance.Lighture.SectionTitle"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_otp_box"
                android:cursorVisible="true"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:maxLines="1"
                android:padding="0dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_placeholder" />

            <EditText
                android:id="@+id/otpDigit6"
                tools:ignore="LabelFor"
                style="@style/TextAppearance.Lighture.SectionTitle"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_otp_box"
                android:cursorVisible="true"
                android:gravity="center"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="1"
                android:maxLines="1"
                android:padding="0dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_placeholder" />
        </LinearLayout>

        <TextView
            android:id="@+id/otpError"
            style="@style/TextAppearance.Lighture.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center_horizontal"
            android:text="@string/auth_otp_invalid"
            android:textColor="@color/color_danger"
            android:visibility="gone" />

        <TextView
            android:id="@+id/otpCountdown"
            style="@style/TextAppearance.Lighture.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center_horizontal"
            android:text="@string/auth_otp_countdown"
            android:textColor="@color/text_secondary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/otpVerifyButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_lg"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/bg_button_gradient"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawablePadding="@dimen/space_2"
            android:drawableTint="@color/text_inverse"
            android:elevation="@dimen/elevation_card"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:text="@string/auth_otp_verify"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.Lighture.Label"
            android:textColor="@color/text_inverse" />

        <LinearLayout
            android:id="@+id/otpResendRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/otpResendPrompt"
                style="@style/TextAppearance.Lighture.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_otp_resend_prompt"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/resendLink"
                style="@style/TextAppearance.Lighture.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="@dimen/space_1"
                android:paddingTop="@dimen/space_1"
                android:paddingEnd="@dimen/space_1"
                android:paddingBottom="@dimen/space_1"
                android:text="@string/auth_otp_resend"
                android:textColor="@color/text_brand" />
        </LinearLayout>

        <!-- Security card -->
        <FrameLayout
            android:id="@+id/otpSecurityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/bg_privacy_card">

            <LinearLayout
                android:id="@+id/otpSecurityContentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_compact">

                <FrameLayout
                    android:id="@+id/otpSecurityIconContainer"
                    android:layout_width="@dimen/size_touch_min"
                    android:layout_height="@dimen/size_touch_min"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:id="@+id/otpSecurityIcon"
                        android:layout_width="@dimen/size_icon_md"
                        android:layout_height="@dimen/size_icon_md"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_shield"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/otpSecurityTextBlock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/otpSecurityTitle"
                        style="@style/TextAppearance.Lighture.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_otp_security_title"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/otpSecurityBody"
                        style="@style/TextAppearance.Lighture.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/auth_otp_security_body"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/otpSpamHint"
            style="@style/TextAppearance.Lighture.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_horizontal"
            android:text="@string/auth_otp_spam_hint"
            android:textColor="@color/text_tertiary" />

    </LinearLayout>
</ScrollView>
