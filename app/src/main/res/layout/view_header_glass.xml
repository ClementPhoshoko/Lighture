<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable glassmorphic header: title/subtitle on left, action on right, bottom divider.
     Matches home header style. Use via <include> inside a ConstraintLayout with elevation. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Glass background surface -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_card_modern"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ambient glow -->
    <ImageView
        android:id="@+id/headerGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="-32dp"
        android:alpha="0.3"
        android:contentDescription="@null"
        android:src="@drawable/ic_decorative_blob"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/glass_blob_danger" />

    <!-- Title Row -->
    <LinearLayout
        android:id="@+id/headerTitleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_20"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding_x"
        android:paddingEnd="@dimen/page_padding_x"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/headerTitleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/headerTitle"
                style="@style/TextAppearance.Lighture.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_size_xl"
                tools:text="Title" />

            <TextView
                android:id="@+id/headerSubtitle"
                style="@style/TextAppearance.Lighture.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0_5"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                tools:text="Subtitle" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/headerActionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/headerActionButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_icon_container"
                android:padding="@dimen/space_3"
                app:tint="@color/icon_primary" />

            <View
                android:id="@+id/headerActionBadge"
                android:layout_width="@dimen/notification_badge"
                android:layout_height="@dimen/notification_badge"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/space_0_5"
                android:layout_marginEnd="@dimen/space_0_5"
                android:background="@drawable/bg_notification_badge"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/headerActionTextButton"
                style="@style/Widget.Lighture.Button.Soft"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_button_md"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:textAllCaps="false"
                android:visibility="gone"
                app:iconPadding="@dimen/space_1_5"
                app:iconSize="@dimen/size_icon_sm"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Lighture.Button.Small"
                tools:text="Action"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom divider -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/headerTitleRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>