<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card: brand gradient surface. Text stack runs full width on top
     (so the title never wraps); the bottom row holds the two compact scan
     actions on the left and the hero art on the right. The image sits in a
     weighted container AFTER the buttons, so the buttons always measure at
     their natural width and the image absorbs the leftover space. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:elevation="@dimen/elevation_card_feature"
    android:paddingTop="@dimen/space_2">

    <!-- Glass background with brand tint -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_card_stat"
        android:backgroundTint="@color/glass_tint_danger"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ambient glow -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="-32dp"
        android:alpha="0.4"
        android:contentDescription="@null"
        android:src="@drawable/ic_decorative_blob"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/glass_blob_danger" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heroContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/heroTitle"
            style="@style/TextAppearance.Lighture.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/home_hero_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_size_2xl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/heroSubtitle"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_3"
            android:text="@string/home_hero_subtitle"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toStartOf="@+id/heroImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/heroTakePhoto"
            style="@style/Widget.Lighture.Button.HeroPrimary.Small"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/hero_button_height"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/home_hero_take_photo"
            app:icon="@drawable/ic_camera"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroSubtitle"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/heroLiveScan"
            style="@style/Widget.Lighture.Button.HeroSecondary.Small"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/hero_button_height"
            android:layout_marginStart="@dimen/hero_buttons_gap"
            android:backgroundTint="@color/glass_pill_bg"
            android:text="@string/home_hero_live_scan"
            app:icon="@drawable/ic_scan"
            app:layout_constraintBottom_toBottomOf="@+id/heroTakePhoto"
            app:layout_constraintStart_toEndOf="@id/heroTakePhoto"
            app:layout_constraintTop_toTopOf="@+id/heroTakePhoto"
            app:strokeColor="@color/glass_pill_border"
            app:strokeWidth="1dp" />

        <ImageView
            android:id="@+id/heroImage"
            android:layout_width="@dimen/hero_image_size"
            android:layout_height="@dimen/hero_image_size"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
