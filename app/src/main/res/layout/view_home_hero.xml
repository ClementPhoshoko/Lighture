<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card: brand gradient surface. Text stack runs full width on top
     (so the title never wraps); the bottom row holds the two compact scan
     actions on the left and the hero art on the right. The image sits in a
     weighted container AFTER the buttons, so the buttons always measure at
     their natural width and the image absorbs the leftover space. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_feature_card"
    android:clipToOutline="true"
    android:elevation="@dimen/elevation_card_feature"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/heroTextColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_6">

        <TextView
            android:id="@+id/heroTitle"
            style="@style/TextAppearance.Lighture.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_hero_title"
            android:textColor="@color/feature_card_text"
            android:textSize="@dimen/font_size_2xl" />

        <TextView
            android:id="@+id/heroSubtitle"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/home_hero_subtitle"
            android:textColor="@color/feature_card_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/heroTakePhoto"
                    style="@style/Widget.Lighture.Button.HeroPrimary.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/hero_button_height"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/home_hero_take_photo"
                    app:icon="@drawable/ic_camera" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/heroLiveScan"
                    style="@style/Widget.Lighture.Button.HeroSecondary.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/hero_button_height"
                    android:layout_marginStart="@dimen/hero_buttons_gap"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/home_hero_live_scan"
                    app:icon="@drawable/ic_scan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                android:gravity="center_vertical|end">

                <ImageView
                    android:id="@+id/heroImage"
                    android:layout_width="@dimen/hero_image_size"
                    android:layout_height="@dimen/hero_image_size"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
