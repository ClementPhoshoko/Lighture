<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_2"
    android:paddingEnd="@dimen/space_2">

    <FrameLayout
        android:id="@+id/categoryIconContainer"
        android:layout_width="@dimen/size_avatar_lg"
        android:layout_height="@dimen/size_avatar_lg"
        android:background="@drawable/bg_category_icon_selector">

        <ImageView
            android:id="@+id/categoryIcon"
            android:layout_width="@dimen/size_icon_lg"
            android:layout_height="@dimen/size_icon_lg"
            android:layout_gravity="center"
            app:tint="@color/category_icon_selector" />
    </FrameLayout>

    <TextView
        android:id="@+id/categoryName"
        style="@style/TextAppearance.Lighture.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:textColor="@color/category_text_selector" />
</LinearLayout>
