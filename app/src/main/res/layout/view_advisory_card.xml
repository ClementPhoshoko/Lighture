<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:background="@drawable/bg_glass_card_advisory">

    <!-- Subtle Background Watermark Icon on the Right (large size, low visibility) -->
    <ImageView
        android:id="@+id/advisoryIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:alpha="0.18"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_outline_trend_up"
        app:tint="@color/fresh_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp" />

    <!-- Card Content (Text container) -->
    <LinearLayout
        android:id="@+id/advisoryContentRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_5"
        android:layout_marginBottom="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/advisoryTitle"
            style="@style/TextAppearance.Lighture.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            tools:text="You're doing great!" />

        <TextView
            android:id="@+id/advisoryBody"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:textColor="@color/text_secondary"
            tools:text="Keep scanning your fridge to save money." />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
