<?xml version="1.0" encoding="utf-8"?>
<!-- Success content, inflated into the auth frame. Shown after the password
     has been reset; avatar is loaded from assets. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_x"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/page_padding_x"
        android:paddingBottom="@dimen/space_8">

        <include
            android:id="@+id/authHeader"
            layout="@layout/view_auth_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4" />

        <ImageView
            android:id="@+id/successAvatar"
            android:layout_width="@dimen/size_avatar_2xl"
            android:layout_height="@dimen/size_avatar_2xl"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:contentDescription="@string/auth_success_title"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/successTitle"
            style="@style/TextAppearance.Lighture.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center_horizontal"
            android:text="@string/auth_success_title"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/successSubtitle"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_horizontal"
            android:text="@string/auth_success_subtitle"
            android:textColor="@color/text_secondary" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:clipChildren="false">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/successButton"
                style="@style/Widget.Lighture.AuthButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_button_lg"
                android:contentDescription="@string/auth_success_description"
                android:text="@string/auth_success_button"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/button_max_width"
                tools:ignore="VisualLintButtonSize" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
