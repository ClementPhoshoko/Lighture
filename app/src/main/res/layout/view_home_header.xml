<?xml version="1.0" encoding="utf-8"?>
<!-- Home page header: greeting title + notification action.
     Mirrors the recipesHeaderRoot structure for consistent layout behavior. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_2">

    <TextView
        android:id="@+id/homeGreeting"
        style="@style/TextAppearance.Lighture.PageTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_3"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_size_xl"
        app:layout_constraintEnd_toStartOf="@+id/notificationWrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Good morning," />

    <TextView
        android:id="@+id/homeSubtitle"
        style="@style/TextAppearance.Lighture.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_0_5"
        android:layout_marginEnd="@dimen/space_3"
        android:text="@string/home_subtitle"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toStartOf="@+id/notificationWrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeGreeting" />

    <FrameLayout
        android:id="@+id/notificationWrap"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/notificationButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/home_notification_description"
            android:padding="@dimen/space_3"
            app:srcCompat="@drawable/ic_bell"
            app:tint="@color/icon_primary" />

        <View
            android:id="@+id/notificationBadge"
            android:layout_width="@dimen/notification_badge"
            android:layout_height="@dimen/notification_badge"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/space_0_5"
            android:layout_marginEnd="@dimen/space_0_5"
            android:background="@drawable/bg_notification_badge" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
