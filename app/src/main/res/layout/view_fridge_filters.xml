<?xml version="1.0" encoding="utf-8"?>
<!-- Fridge freshness filter row: horizontal scrollable category chips reusing
     the Recipes category component (CategoryAdapter + item_recipe_category). -->
<androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fridgeCategoryList"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:paddingStart="@dimen/page_padding_x"
    android:paddingEnd="@dimen/page_padding_x"
    android:orientation="horizontal"
    android:overScrollMode="never"
    android:scrollbars="none" />
