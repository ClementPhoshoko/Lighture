<?xml version="1.0" encoding="utf-8"?>
<!-- Registration content, inflated into the auth frame. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_x"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/page_padding_x"
        android:paddingBottom="@dimen/space_8">

        <include
            android:id="@+id/authHeader"
            layout="@layout/view_auth_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4" />

        <TextView
            android:id="@+id/registerTitle"
            style="@style/TextAppearance.Lighture.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center_horizontal"
            android:text="@string/auth_register_title"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/registerSubtitle"
            style="@style/TextAppearance.Lighture.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_horizontal"
            android:text="@string/auth_register_subtitle"
            android:textColor="@color/text_secondary" />

        <!-- Full name field -->
        <LinearLayout
            android:id="@+id/nameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/bg_auth_field_selector"
            android:baselineAligned="false"
            android:elevation="@dimen/elevation_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <FrameLayout
                android:id="@+id/nameIconContainer"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/nameIcon"
                    android:layout_width="@dimen/size_icon_md"
                    android:layout_height="@dimen/size_icon_md"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_shield"
                    app:tint="@color/icon_brand" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/nameFieldBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nameLabel"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_field_label_name"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/nameInput"
                    style="@style/TextAppearance.Lighture.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/auth_hint_name"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="yes"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:minHeight="@dimen/size_touch_min"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_placeholder" />
            </LinearLayout>
        </LinearLayout>

        <!-- Email field -->
        <LinearLayout
            android:id="@+id/registerEmailField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_auth_field_selector"
            android:baselineAligned="false"
            android:elevation="@dimen/elevation_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <FrameLayout
                android:id="@+id/registerEmailIconContainer"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/registerEmailIcon"
                    android:layout_width="@dimen/size_icon_md"
                    android:layout_height="@dimen/size_icon_md"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_email"
                    app:tint="@color/icon_brand" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/registerEmailFieldBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/registerEmailLabel"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_field_label_email"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/registerEmailInput"
                    style="@style/TextAppearance.Lighture.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/auth_hint_email"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:minHeight="@dimen/size_touch_min"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_placeholder" />
            </LinearLayout>
        </LinearLayout>

        <!-- Password field -->
        <LinearLayout
            android:id="@+id/registerPasswordField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_auth_field_selector"
            android:baselineAligned="false"
            android:elevation="@dimen/elevation_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <FrameLayout
                android:id="@+id/registerPasswordIconContainer"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/registerPasswordIcon"
                    android:layout_width="@dimen/size_icon_md"
                    android:layout_height="@dimen/size_icon_md"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_lock"
                    app:tint="@color/icon_brand" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/registerPasswordFieldBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/registerPasswordLabel"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_field_label_password"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/registerPasswordInput"
                    style="@style/TextAppearance.Lighture.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/auth_hint_password"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="@dimen/size_touch_min"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_placeholder" />

                <LinearLayout
                    android:id="@+id/registerPasswordStrengthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1_5"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/registerStrengthRuler"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/registerStrengthSegment1"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/password_meter_height"
                            android:layout_marginEnd="@dimen/space_0_5"
                            android:layout_weight="1"
                            android:background="@drawable/bg_password_segment" />

                        <View
                            android:id="@+id/registerStrengthSegment2"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/password_meter_height"
                            android:layout_marginStart="@dimen/space_0_5"
                            android:layout_marginEnd="@dimen/space_0_5"
                            android:layout_weight="1"
                            android:background="@drawable/bg_password_segment" />

                        <View
                            android:id="@+id/registerStrengthSegment3"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/password_meter_height"
                            android:layout_marginStart="@dimen/space_0_5"
                            android:layout_weight="1"
                            android:background="@drawable/bg_password_segment" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/registerPasswordStrengthLabel"
                        style="@style/TextAppearance.Lighture.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/toggleRegisterPassword"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_show_password"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_eye"
                app:tint="@color/icon_secondary" />
        </LinearLayout>

        <!-- Confirm password field -->
        <LinearLayout
            android:id="@+id/registerConfirmField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_auth_field_selector"
            android:baselineAligned="false"
            android:elevation="@dimen/elevation_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <FrameLayout
                android:id="@+id/registerConfirmIconContainer"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/registerConfirmIcon"
                    android:layout_width="@dimen/size_icon_md"
                    android:layout_height="@dimen/size_icon_md"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_lock"
                    app:tint="@color/icon_brand" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/registerConfirmFieldBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/registerConfirmLabel"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_field_label_confirm"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/registerConfirmInput"
                    style="@style/TextAppearance.Lighture.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/auth_hint_password"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="@dimen/size_touch_min"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_placeholder" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/toggleRegisterConfirm"
                android:layout_width="@dimen/size_touch_min"
                android:layout_height="@dimen/size_touch_min"
                android:layout_marginStart="@dimen/space_2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_show_password"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_eye"
                app:tint="@color/icon_secondary" />
        </LinearLayout>

        <!-- Password requirements card -->
        <FrameLayout
            android:id="@+id/requirementsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_privacy_card">

            <LinearLayout
                android:id="@+id/requirementsContentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_compact">

                <FrameLayout
                    android:id="@+id/requirementsIconContainer"
                    android:layout_width="@dimen/size_touch_min"
                    android:layout_height="@dimen/size_touch_min"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:id="@+id/requirementsIcon"
                        android:layout_width="@dimen/size_icon_md"
                        android:layout_height="@dimen/size_icon_md"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_shield"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/requirementsTextBlock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/requirementsTitle"
                        style="@style/TextAppearance.Lighture.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_register_requirements_title"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/requirementsBody"
                        style="@style/TextAppearance.Lighture.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/auth_register_requirements"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:clipChildren="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                style="@style/Widget.Lighture.AuthButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_button_lg"
                android:contentDescription="@string/auth_register_description"
                android:text="@string/auth_register_button"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/button_max_width"
                tools:ignore="VisualLintButtonSize" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/authDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dividerLineStart"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/dividerLabel"
                style="@style/TextAppearance.Lighture.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_marginEnd="@dimen/space_3"
                android:text="@string/auth_or_continue"
                android:textColor="@color/text_tertiary" />

            <View
                android:id="@+id/dividerLineEnd"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/socialRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/registerSocialGoogle"
                android:layout_width="0dp"
                android:layout_height="@dimen/social_button_size"
                android:layout_weight="1"
                android:background="@drawable/bg_social_button"
                android:clickable="true"
                android:elevation="@dimen/elevation_card"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/registerSocialGoogleIcon"
                    android:layout_width="@dimen/size_icon_lg"
                    android:layout_height="@dimen/size_icon_lg"
                    android:layout_gravity="center"
                    android:contentDescription="@string/auth_social_google"
                    app:srcCompat="@drawable/ic_brand_google" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/registerSocialApple"
                android:layout_width="0dp"
                android:layout_height="@dimen/social_button_size"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_social_button"
                android:clickable="true"
                android:elevation="@dimen/elevation_card"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/registerSocialAppleIcon"
                    android:layout_width="@dimen/size_icon_lg"
                    android:layout_height="@dimen/size_icon_lg"
                    android:layout_gravity="center"
                    android:contentDescription="@string/auth_social_apple"
                    app:srcCompat="@drawable/ic_brand_apple" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/registerSocialFacebook"
                android:layout_width="0dp"
                android:layout_height="@dimen/social_button_size"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_social_button"
                android:clickable="true"
                android:elevation="@dimen/elevation_card"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/registerSocialFacebookIcon"
                    android:layout_width="@dimen/size_icon_lg"
                    android:layout_height="@dimen/size_icon_lg"
                    android:layout_gravity="center"
                    android:contentDescription="@string/auth_social_facebook"
                    app:srcCompat="@drawable/ic_brand_facebook" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/loginPrompt"
                style="@style/TextAppearance.Lighture.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_login_prompt"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/loginLink"
                style="@style/TextAppearance.Lighture.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="@dimen/space_1"
                android:paddingTop="@dimen/space_1"
                android:paddingEnd="@dimen/space_1"
                android:paddingBottom="@dimen/space_1"
                android:text="@string/auth_login_link"
                android:textColor="@color/text_brand" />
        </LinearLayout>

        <TextView
            android:id="@+id/registerAgreement"
            style="@style/TextAppearance.Lighture.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:textColor="@color/text_tertiary" />

    </LinearLayout>
</ScrollView>
