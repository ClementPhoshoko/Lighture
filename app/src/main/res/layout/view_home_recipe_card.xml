<?xml version="1.0" encoding="utf-8"?>
<!-- Recipe card: pastel image placeholder with a white time pill overlaid at
     the bottom-left of the image, then the title and a footer row holding the
     category tag pill on the left and the favourite heart + likes on the
     right. clipToOutline keeps the art and pill inside the 16dp rounded card. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recipeCard"
    style="@style/Widget.Lighture.Card"
    android:layout_width="@dimen/recipe_card_width"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/recipeArt"
            android:layout_width="match_parent"
            android:layout_height="@dimen/recipe_art_height"
            android:background="@drawable/bg_recipe_image">

            <ImageView
                android:id="@+id/recipeIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/recipeTimePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/space_2"
                android:background="@drawable/bg_time_chip"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_2"
                android:paddingTop="@dimen/space_0_5"
                android:paddingEnd="@dimen/space_2"
                android:paddingBottom="@dimen/space_0_5">

                <ImageView
                    android:layout_width="@dimen/size_icon_xs"
                    android:layout_height="@dimen/size_icon_xs"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/icon_primary" />

                <TextView
                    android:id="@+id/recipeTime"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_compact">

            <TextView
                android:id="@+id/recipeTitle"
                style="@style/TextAppearance.Lighture.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/recipeTag"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_pill"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_2"
                    android:paddingTop="@dimen/space_0_5"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="@dimen/space_0_5" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/recipeHeartButton"
                    android:layout_width="@dimen/size_icon_lg"
                    android:layout_height="@dimen/size_icon_lg"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:id="@+id/recipeHeartIcon"
                        android:layout_width="@dimen/size_icon_xs"
                        android:layout_height="@dimen/size_icon_xs"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_heart_outline"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/recipeLikes"
                    style="@style/TextAppearance.Lighture.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
