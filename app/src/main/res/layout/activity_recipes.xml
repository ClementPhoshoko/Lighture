<?xml version="1.0" encoding="utf-8"?>
<!-- Recipes screen shell: pinned header with system-bar insets, a scrollable
     body (category chips, filter/sort row, recipe list) and the shared bottom
     navigation. Mirrors the home screen's inset handling. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recipesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_page"
    tools:context=".RecipesActivity">

    <LinearLayout
        android:id="@+id/recipesTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/glass_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_x"
        android:paddingEnd="@dimen/page_padding_x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/view_recipes_header" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/recipesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recipesTop">

        <LinearLayout
            android:id="@+id/recipesContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding_x"
            android:paddingTop="@dimen/page_padding_top"
            android:paddingEnd="@dimen/page_padding_x"
            android:paddingBottom="@dimen/space_8">

            <include layout="@layout/view_recipes_category_chips" />

            <include
                layout="@layout/view_recipes_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recipesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Lighture.BottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_0"
        android:paddingBottom="@dimen/space_0"
        app:itemActiveIndicatorStyle="@style/Widget.Lighture.BottomNavigationView.ActiveIndicator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
