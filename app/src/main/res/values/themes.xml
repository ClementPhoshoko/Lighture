<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Lighture — Application theme.
      All colours are resolved through @color tokens, so the values-night
      colours.xml automatically provides the dark mode variant.
    -->
    <style name="Base.Theme.Lighture" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/button_primary_text</item>
        <item name="colorPrimaryContainer">@color/brand_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/red_700</item>

        <!-- Accent -->
        <item name="colorSecondary">@color/red_accent</item>
        <item name="colorOnSecondary">@color/button_primary_text</item>
        <item name="colorSecondaryContainer">@color/icon_container_background</item>
        <item name="colorOnSecondaryContainer">@color/red_700</item>

        <!-- Tertiary (neutral brand support) -->
        <item name="colorTertiary">@color/food_dairy</item>
        <item name="colorOnTertiary">@color/button_primary_text</item>
        <item name="colorTertiaryContainer">@color/food_dairy_soft</item>
        <item name="colorOnTertiaryContainer">@color/color_info_strong</item>

        <!-- Error / danger -->
        <item name="colorError">@color/color_danger</item>
        <item name="colorOnError">@color/button_primary_text</item>
        <item name="colorErrorContainer">@color/color_danger_soft</item>
        <item name="colorOnErrorContainer">@color/color_danger_strong</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_tertiary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorSurfaceContainerLowest">@color/neutral_0</item>
        <item name="colorSurfaceContainerLow">@color/background_muted</item>
        <item name="colorSurfaceContainer">@color/surface_secondary</item>
        <item name="colorSurfaceContainerHigh">@color/surface_tertiary</item>
        <item name="colorSurfaceContainerHighest">@color/neutral_200</item>

        <!-- Outlines -->
        <item name="colorOutline">@color/border_default</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <!-- Backgrounds -->
        <!-- Window background stays a plain colour (a large bitmap here is
             redrawn at the wrong scale during the splash-exit transition).
             The themed fruit-icon background (@drawable/bg_system) is applied
             as a normal view background on each screen: drawn post-layout, it
             never distorts, and its colors resolve per light/dark mode. -->
        <item name="android:colorBackground">@color/background_app</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/background_app</item>

        <!-- System bars: transparent so the background image bleeds behind them
             (activities already handle insets edge-to-edge). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_navigation_bar</item>

        <!-- Default typography -->
        <item name="android:textAppearance">@style/TextAppearance.Lighture.Body</item>

        <!-- Material Components default styles -->
        <item name="materialCardViewStyle">@style/Widget.Lighture.Card</item>
        <item name="materialButtonStyle">@style/Widget.Lighture.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Lighture.Button.Secondary</item>
        <item name="materialButtonToggleGroupStyle">@style/Widget.Lighture.Button.ToggleGroup</item>
        <item name="chipStyle">@style/Widget.Lighture.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.Lighture.BottomNavigationView</item>
        <item name="toolbarStyle">@style/Widget.Lighture.TopAppBar</item>
        <item name="floatingActionButtonStyle">@style/Widget.Lighture.FloatingActionButton</item>
        <item name="textInputStyle">@style/Widget.Lighture.TextInputLayout</item>

        <!-- Focus highlight -->
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:colorControlHighlight">@color/red_glow</item>

    </style>

    <style name="Theme.Lighture" parent="Base.Theme.Lighture" />

    <!-- =============================================================
         SPLASH — premium branded launch screen.
         Uses the core-splashscreen library for consistent behaviour on
         every API level (24+). The system splash keeps the app icon on a
         plain background, then the activity takes over with the full
         branded composition.
    ============================================================= -->
    <style name="Theme.Lighture.Splash" parent="Theme.SplashScreen">

        <!-- System splash (API 31+) -->
        <item name="windowSplashScreenBackground">@color/neutral_0</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Lighture</item>

        <!-- Pre-31 fallback: the branded gradient is already the activity window -->
        <item name="android:windowBackground">@drawable/splash_background</item>

        <!-- Edge-to-edge, light system bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_navigation_bar</item>
    </style>
</resources>
